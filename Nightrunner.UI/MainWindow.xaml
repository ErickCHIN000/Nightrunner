<Window x:Class="Nightrunner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nightrunner.UI"
        xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:adl="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        mc:Ignorable="d"
        Title="Nightrunner" Height="880" Width="1600" Icon="/nr.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiSize}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static local:MainWindow.FocusSearchCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- main bar: app name, the open game and project, then the window controls -->
        <Border Grid.Row="0" Background="{StaticResource Bg2}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,7">
                <Border DockPanel.Dock="Left" Width="4" Height="20" Background="{DynamicResource Accent}"
                        Margin="0,0,10,0"/>
                <TextBlock DockPanel.Dock="Left" Text="NIGHTRUNNER" FontWeight="SemiBold"
                           Foreground="{StaticResource FgBright}" Margin="0,0,16,0"/>
                <TextBlock DockPanel.Dock="Left" x:Name="GameLabel" Foreground="{DynamicResource Accent}"
                           FontWeight="SemiBold" Margin="0,0,10,0"/>
                <TextBlock DockPanel.Dock="Left" x:Name="ProjectLabel" Style="{StaticResource Dim}"
                           Margin="0,0,18,0"/>

                <Button DockPanel.Dock="Left" x:Name="BtnWindows" Content="Windows ▾" Click="Windows_Click"
                        Padding="10,3" Margin="0,0,6,0" IsEnabled="False"/>
                <Button DockPanel.Dock="Left" x:Name="BtnViews" Content="Views ▾" Click="Views_Click"
                        Padding="10,3" IsEnabled="False"
                        ToolTip="Workspace views: saved arrangements of windows"/>

                <Button DockPanel.Dock="Right" x:Name="BtnSettings" Content="Settings" Click="Settings_Click"
                        Padding="12,3"/>
                <Button DockPanel.Dock="Right" x:Name="BtnGames" Content="Games" Click="Games_Click"
                        Padding="12,3" Margin="0,0,6,0"/>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- the shell pages (selector / settings) or the dock -->
        <ContentControl x:Name="ViewHost" Grid.Row="1"/>

        <ad:DockingManager x:Name="Dock" Grid.Row="1" Visibility="Collapsed"
                           Background="{StaticResource Bg}" AllowMixedOrientation="True">
            <adl:LayoutRoot>
                <adl:LayoutPanel Orientation="Horizontal">
                    <adl:LayoutDocumentPane x:Name="DocPane"/>
                </adl:LayoutPanel>
            </adl:LayoutRoot>
        </ad:DockingManager>

        <!-- jobs: the running export (progress, cancel) and how many wait behind it; the last result otherwise -->
        <Border Grid.Row="2" x:Name="JobBar" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Visibility="Collapsed">
            <DockPanel Margin="10,3">
                <Button DockPanel.Dock="Right" x:Name="JobCancel" Content="Cancel" Click="JobCancel_Click" Padding="8,1"/>
                <TextBlock DockPanel.Dock="Right" x:Name="JobQueued" Style="{StaticResource Dim}" Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
                <ProgressBar DockPanel.Dock="Right" x:Name="JobProgress" Width="180" Height="6" Margin="0,0,10,0"
                             Maximum="1" VerticalAlignment="Center"/>
                <TextBlock x:Name="JobText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
