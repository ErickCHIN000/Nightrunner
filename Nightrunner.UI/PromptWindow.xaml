<Window x:Class="Nightrunner.UI.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nightrunner" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiSize}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="16">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="Input" KeyDown="Input_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="14,4" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" Click="Ok_Click" Padding="18,4" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
