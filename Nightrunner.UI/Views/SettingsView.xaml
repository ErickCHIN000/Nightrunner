<UserControl x:Class="Nightrunner.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiSize}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100" Margin="24,20" HorizontalAlignment="Center">
            <TextBlock Text="Game paths" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource FgBright}"/>
            <TextBlock x:Name="SettingsPath" Style="{StaticResource Dim}" FontSize="11.5" Margin="0,3,0,18"/>

            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding Accent}"/>
                                <StackPanel Grid.Column="1" Margin="14,12">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="{StaticResource FgBright}"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Id}" Margin="8,0,0,0"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                   Foreground="{Binding Accent}"/>
                                        <TextBlock Text="{Binding Support}" HorizontalAlignment="Right"
                                                   Foreground="{Binding SupportBrush}" FontSize="12"/>
                                    </DockPanel>

                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Validate" Padding="12,4"
                                                Margin="6,0,0,0" Click="Validate_Click" Tag="{Binding}"/>
                                        <Button DockPanel.Dock="Right" Content="Detect" Padding="12,4"
                                                Margin="6,0,0,0" Click="Detect_Click" Tag="{Binding}"/>
                                        <Button DockPanel.Dock="Right" Content="Browse" Padding="12,4"
                                                Margin="6,0,0,0" Click="Browse_Click" Tag="{Binding}"/>
                                        <TextBox Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}"
                                                
                                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                 Tag="{Binding}" LostFocus="Root_LostFocus"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                               Margin="0,8,0,0" FontSize="12"/>

                                    <ItemsControl ItemsSource="{Binding Checks}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}"
                                                               Width="110" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11.5" Foreground="{StaticResource FgDim}"/>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding State}"
                                                               Width="64" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11.5" Foreground="{Binding StateBrush}"/>
                                                    <TextBlock Text="{Binding Path}" FontSize="11.5"
                                                               Foreground="{StaticResource FgFaint}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Path}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" Padding="10,8" Margin="0,10,0,0"
                                            Visibility="{Binding RuntimeVisibility}">
                                        <StackPanel>
                                            <DockPanel>
                                                <ToggleButton DockPanel.Dock="Right" Content="{Binding RuntimeToggleText}"
                                                              MinWidth="44" Margin="6,0,0,0" IsChecked="{Binding RuntimeEnabled}"
                                                              IsEnabled="{Binding RuntimeAvailable}"
                                                              Click="RuntimeToggle_Click" Tag="{Binding}"
                                                              ToolTip="Show what the runtime loads in the app"/>
                                                <Button DockPanel.Dock="Right" Content="Validate" Padding="12,4"
                                                        IsEnabled="{Binding RuntimeAvailable}"
                                                        Click="RuntimeValidate_Click" Tag="{Binding}"/>
                                                <TextBlock DockPanel.Dock="Left" Text="Runtime"
                                                           Foreground="{StaticResource FgBright}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding RuntimeName}" Margin="10,0,0,0"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                           Foreground="{Binding RuntimeBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding RuntimeStatus}" FontSize="12" Margin="0,6,0,0"
                                                       Foreground="{Binding RuntimeBrush}" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding RuntimePaths}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,1">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}"
                                                                       Width="110" FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="11.5" Foreground="{StaticResource FgDim}"/>
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding State}"
                                                                       Width="64" FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="11.5" Foreground="{Binding StateBrush}"/>
                                                            <TextBlock Text="{Binding Path}" FontSize="11.5"
                                                                       Foreground="{StaticResource FgFaint}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Path}"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding RuntimeMods}" FontSize="12" Margin="0,6,0,0"
                                                       Foreground="{StaticResource Fg}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="Open this game" Padding="12,4" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Click="Play_Click" Tag="{Binding}"
                                            Visibility="{Binding CanOpen}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
