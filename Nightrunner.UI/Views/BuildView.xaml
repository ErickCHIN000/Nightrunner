<UserControl x:Class="Nightrunner.UI.Views.BuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiSize}">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <!-- the title keeps its width; the path beside it takes what is left and trims -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="4" Height="20" Background="{DynamicResource Accent}" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" x:Name="Title" Text="no project open" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource FgBright}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="Meta" Style="{StaticResource Dim}" FontSize="11.5"
                               Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label Content="pack"/>
                    <TextBox Grid.Column="1" x:Name="PackName" Margin="0,0,0,6" TextChanged="Names_Changed"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Refresh" Click="Refresh_Click" Padding="12,4" Margin="6,0,0,0"/>
                        <Button Content="Check" Click="Check_Click" Padding="14,4" Margin="6,0,0,0"
                                ToolTip="Dry run: the whole build into a temp folder, deleted after; nothing is kept"/>
                        <Button Content="Build" Click="Build_Click" Padding="18,4" Margin="6,0,0,0"/>
                    </StackPanel>

                    <Label Grid.Row="1" Content="pak"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="PakName" Margin="0,0,0,6" TextChanged="Names_Changed"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                    <CheckBox Grid.Row="1" Grid.Column="2" x:Name="PlainClips" Content="plain clips"
                              Margin="6,0,0,6" VerticalAlignment="Center" Click="PlainClips_Click"/>

                    <Label Grid.Row="2" Content="output"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="OutFolder"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" IsReadOnly="True"/>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Browse" Click="Browse_Click" Padding="12,4" Margin="6,0,0,0"/>
                        <Button Content="Folder" Click="Reveal_Click" Padding="12,4" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- what the build writes: each file, where it goes, its runtime load order, what changed -->
                <ListView x:Name="Outputs" Margin="0,8,0,0" MaxHeight="110">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="file" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding File}" Style="{StaticResource CellName}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="to" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Destination}" Style="{StaticResource CellDim}" ToolTip="{Binding Destination}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="load" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OrderText}" Style="{StaticResource CellNum}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="last" Width="210">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastText}" Style="{StaticResource CellDim}" ToolTip="{Binding LastText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="check" Width="210">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CheckText}" Style="{StaticResource CellDim}" ToolTip="{Binding CheckText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RevealButton" Content="Reveal" Click="RevealItem_Click" Padding="12,4" Margin="6,0,0,0"
                        IsEnabled="False"/>
                <Button x:Name="OpenButton" Content="Open" Click="OpenItem_Click" Padding="12,4" Margin="6,0,0,0"
                        IsEnabled="False"/>
                <Button x:Name="ViewButton" Content="View" Click="ViewItem_Click" Padding="12,4" Margin="6,0,0,0"
                        IsEnabled="False"/>
            </StackPanel>
            <Label DockPanel.Dock="Left" Content="kind"/>
            <ComboBox x:Name="KindFilter" Width="160" HorizontalAlignment="Left" SelectionChanged="KindFilter_Changed"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="Status" Style="{StaticResource Dim}" Margin="2,6,0,0"
                   TextWrapping="Wrap"/>

        <ListView x:Name="Rows" SelectionChanged="Rows_SelectionChanged" MouseDoubleClick="Rows_DoubleClick"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="kind" Width="58">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Kind}" Style="{StaticResource CellType}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="item" Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{Binding NameBrush}" ToolTip="{Binding NameTip}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="form" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Form}" Style="{StaticResource CellDim}" ToolTip="{Binding Form}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="into" Width="48">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Pack}" Style="{StaticResource CellDim}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="template" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Template}" Style="{StaticResource CellDim}" ToolTip="{Binding Template}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="source" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource CellDim}" ToolTip="{Binding SourceTip}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="state" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ChangedText}" TextTrimming="CharacterEllipsis" Foreground="{Binding ChangedBrush}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="edits" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Edits}" Style="{StaticResource CellDim}" ToolTip="{Binding Edits}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="last" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastText}" TextTrimming="CharacterEllipsis" Foreground="{Binding LastBrush}" ToolTip="{Binding LastTip}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="diff" Width="84">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DiffText}" TextTrimming="CharacterEllipsis" Foreground="{Binding DiffBrush}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="check" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CheckText}" TextTrimming="CharacterEllipsis" Foreground="{Binding CheckBrush}" ToolTip="{Binding CheckTip}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
