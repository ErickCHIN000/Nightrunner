<UserControl x:Class="Nightrunner.UI.Views.Inspectors.TextureInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiSize}">
    <UserControl.Resources>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#22262B">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#1A1D21">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Label DockPanel.Dock="Left" Content="mip"/>
            <ComboBox DockPanel.Dock="Left" x:Name="MipPicker" Width="112" Margin="0,0,8,0"
                      SelectionChanged="Mip_Changed"/>
            <Label DockPanel.Dock="Left" x:Name="FaceLabel" Content="face"/>
            <ComboBox DockPanel.Dock="Left" x:Name="FacePicker" Width="66" Margin="0,0,8,0"
                      SelectionChanged="Mip_Changed"/>
            <ToggleButton DockPanel.Dock="Right" x:Name="BtnNormal" Content="normal Z" IsChecked="True"
                          Margin="6,0,0,0" Click="Mip_Changed"
                          ToolTip="Two-channel data (BC5): rebuild Z so a normal map looks like one"/>
            <ToggleButton DockPanel.Dock="Right" x:Name="BtnAlpha" Content="alpha" IsChecked="True"
                          Margin="6,0,0,0" Click="Render_Click"/>
            <ToggleButton DockPanel.Dock="Right" x:Name="BtnFit" Content="fit" IsChecked="True"
                          Click="Render_Click"/>
            <TextBlock/>
        </DockPanel>

        <TextBox DockPanel.Dock="Bottom" x:Name="Info" Style="{StaticResource Mono}" Height="126"
                 TextWrapping="NoWrap" Margin="0,6,0,0"/>

        <Border Background="{StaticResource Checker}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Image x:Name="Preview" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ScrollViewer>
                <TextBlock x:Name="PreviewNote" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource Warn}" TextWrapping="Wrap" MaxWidth="360"
                           TextAlignment="Center"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
