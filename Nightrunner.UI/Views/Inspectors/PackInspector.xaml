<UserControl x:Class="Nightrunner.UI.Views.Inspectors.PackInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiSize}">
    <DockPanel>
        <TextBox DockPanel.Dock="Top" x:Name="Info" Style="{StaticResource Mono}" Height="120"
                 TextWrapping="NoWrap" Margin="0,0,0,6"/>
        <TextBlock DockPanel.Dock="Top" x:Name="StorageHeader" Style="{StaticResource Dim}" Margin="2,0,0,4"
                   Text="storage table"/>
        <TextBox x:Name="Storages" Style="{StaticResource Mono}" TextWrapping="NoWrap"/>
    </DockPanel>
</UserControl>
