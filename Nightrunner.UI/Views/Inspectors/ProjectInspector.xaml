<UserControl x:Class="Nightrunner.UI.Views.Inspectors.ProjectInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiSize}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Meta" Style="{StaticResource Dim}" FontSize="11.5" Margin="0,0,0,8"/>

            <DockPanel Margin="0,0,0,6">
                <Label DockPanel.Dock="Left" Content="name" Width="52"/>
                <TextBox x:Name="NameBox"/>
            </DockPanel>

            <DockPanel Margin="0,0,0,6">
                <Label DockPanel.Dock="Left" Content="path" Width="52"/>
                <TextBox x:Name="PathBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
            </DockPanel>

            <DockPanel Margin="0,0,0,8">
                <Label DockPanel.Dock="Left" Content="notes" Width="52" VerticalAlignment="Top" Margin="0,4,6,0"/>
                <TextBox x:Name="NotesBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Save" Click="Save_Click" Padding="14,4" Margin="0,0,6,0"/>
                <Button Content="Folder" Click="Reveal_Click" Padding="14,4" Margin="0,0,6,0"/>
                <Button Content="Open" Click="Open_Click" Padding="14,4" Margin="0,0,6,0"
                        ToolTip="Make this the project the other windows work with"/>
                <Button Content="Close" Click="Close_Click" Padding="14,4"/>
            </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="Status" Style="{StaticResource Dim}" Margin="2,6,0,0"
                   TextWrapping="Wrap"/>

        <TextBox x:Name="Summary" Style="{StaticResource Mono}" TextWrapping="NoWrap"/>
    </DockPanel>
</UserControl>
