<UserControl x:Class="Nightrunner.UI.Views.ViewportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vp="clr-namespace:Nightrunner.UI.Viewport"
             Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiSize}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,6,8,6">
            <Button DockPanel.Dock="Left" Content="Frame" Click="Frame_Click" Margin="0,0,6,0" ToolTip="F"/>
            <ToggleButton DockPanel.Dock="Left" x:Name="Wire" Content="Wire" Click="Wire_Click" Margin="0,0,6,0"/>
            <ToggleButton DockPanel.Dock="Left" x:Name="Textured" Content="Textures" IsChecked="True"
                          Click="Textured_Click" Margin="0,0,6,0"/>
            <ToggleButton DockPanel.Dock="Left" x:Name="BonesToggle" Content="Bones" Click="Bones_Click" Margin="0,0,6,0"/>
            <ToggleButton DockPanel.Dock="Left" x:Name="EyeToggle" Content="Eye" Click="Eye_Click" Margin="0,0,6,0"
                          Visibility="Collapsed" ToolTip="Look through eyecamera (first person)"/>
            <ToggleButton DockPanel.Dock="Left" x:Name="ModsToggle" Content="Mods" Click="Mods_Click" Margin="0,0,6,0"
                          ToolTip="On: what the game loads. Off: stock packs and paks only"/>
            <ToggleButton DockPanel.Dock="Left" x:Name="FollowToggle" Content="Follow" Click="Follow_Click" Margin="0,0,6,0"
                          ToolTip="On: a played clip loads its rig's model. Off: it plays on the shown one"/>
            <Border DockPanel.Dock="Left" Width="4"/>
            <Label DockPanel.Dock="Left" x:Name="SkinLabel" Content="Skin"/>
            <ComboBox DockPanel.Dock="Left" x:Name="SkinPicker" Width="190" Margin="0,0,10,0"
                      SelectionChanged="SkinPicker_Changed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Opacity="{Binding Opacity}" ToolTip="{Binding Tip}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ToggleButton DockPanel.Dock="Left" x:Name="SlotsToggle" Content="Slots" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Popup x:Name="SlotsPopup" PlacementTarget="{Binding ElementName=SlotsToggle}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True"
                   IsOpen="{Binding IsChecked, ElementName=SlotsToggle, Mode=TwoWay}">
                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6">
                    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SlotsPanel"/>
                    </ScrollViewer>
                </Border>
            </Popup>
            <TextBlock x:Name="Status" Style="{StaticResource Dim}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" x:Name="AnimBar" Margin="8,4,8,6" Visibility="Collapsed">
            <ToggleButton DockPanel.Dock="Left" x:Name="PlayToggle" Content="Play" Click="Play_Click" Margin="0,0,6,0"/>
            <Button DockPanel.Dock="Left" Content="Rest" Click="Rest_Click" Margin="0,0,6,0" ToolTip="Back to the bind pose"/>
            <ToggleButton DockPanel.Dock="Left" x:Name="LayerToggle" Content="Layer" Click="Layer_Click" Margin="0,0,10,0"
                          ToolTip="On: sequences picked next play over this one. Off: layers removed"/>
            <TextBlock DockPanel.Dock="Right" x:Name="FrameText" Style="{StaticResource Dim}" VerticalAlignment="Center"
                       Width="80" TextAlignment="Right"/>
            <Slider x:Name="Timeline" VerticalAlignment="Center" ValueChanged="Timeline_Changed"/>
        </DockPanel>
        <vp:MeshViewport x:Name="View"/>
    </DockPanel>
</UserControl>
