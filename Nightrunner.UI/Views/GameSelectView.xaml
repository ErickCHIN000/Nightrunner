<UserControl x:Class="Nightrunner.UI.Views.GameSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiSize}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <TextBlock Text="NIGHTRUNNER" FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource FgBright}" HorizontalAlignment="Center"/>
            <TextBlock Text="pick a game" Style="{StaticResource Dim}" Margin="0,4,0,26"
                       HorizontalAlignment="Center"/>

            <!-- one row, one column per game: symmetric however many there are -->
            <ItemsControl x:Name="Games" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Card}" Width="290" Height="230" Margin="9"
                                Click="Game_Click" Tag="{Binding}" IsEnabled="{Binding Usable}">
                            <StackPanel Margin="18,22" HorizontalAlignment="Center">
                                <Grid Width="78" Height="78" HorizontalAlignment="Center">
                                    <Ellipse Stroke="{Binding Accent}" StrokeThickness="2"
                                             Fill="{StaticResource Bg}"/>
                                    <Ellipse Stroke="{Binding Accent}" StrokeThickness="6" Opacity="0.18"
                                             Margin="-4"/>
                                    <TextBlock Text="{Binding Short}" Foreground="{Binding Accent}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="17"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource FgBright}" Margin="0,16,0,0"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" FontSize="12"
                                           Margin="0,6,0,0" HorizontalAlignment="Center" MaxWidth="250"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Visibility="{Binding DetailVisibility}"/>
                                <TextBlock Text="{Binding Root}" Foreground="{StaticResource FgFaint}"
                                           FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           MaxWidth="250" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Root}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="Empty" Style="{StaticResource Dim}" HorizontalAlignment="Center"
                       Visibility="Collapsed" Margin="0,8"
                       Text="no install found — point at a game folder, or open packs directly"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                <Button Content="Browse for a game folder" Click="Browse_Click" Margin="0,0,8,0" Padding="14,6"/>
                <Button Content="Open .rpack files" Click="OpenPacks_Click" Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="Settings" Click="Settings_Click" Padding="14,6"/>
            </StackPanel>

            <TextBlock x:Name="Note" Foreground="{StaticResource Error}" HorizontalAlignment="Center"
                       Margin="0,14,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
